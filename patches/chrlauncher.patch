+static BOOLEAN _app_str_contains_i (
+	_In_ LPCSTR string,
+	_In_ LPCSTR substring
+)
+{
+	size_t substring_length = strlen (substring);
+
+	if (!substring_length)
+		return TRUE;
+
+	for (; *string; string++)
+	{
+		size_t i;
+
+		for (i = 0; i < substring_length; i++)
+		{
+			CHAR a = string[i];
+			CHAR b = substring[i];
+
+			if (!a)
+				return FALSE;
+
+			if (a >= 'A' && a <= 'Z')
+				a += 'a' - 'A';
+
+			if (b >= 'A' && b <= 'Z')
+				b += 'a' - 'A';
+
+			if (a != b)
+				break;
+		}
+
+		if (i == substring_length)
+			return TRUE;
+	}
+
+	return FALSE;
+}
+
+static BOOLEAN _app_str_endsswith_i (
+	_In_ LPCSTR string,
+	_In_ LPCSTR suffix
+)
+{
+	size_t string_length = strlen (string);
+	size_t suffix_length = strlen (suffix);
+
+	if (suffix_length > string_length)
+		return FALSE;
+
+	string += string_length - suffix_length;
+
+	for (size_t i = 0; i < suffix_length; i++)
+	{
+		CHAR a = string[i];
+		CHAR b = suffix[i];
+
+		if (a >= 'A' && a <= 'Z')
+			a += 'a' - 'A';
+
+		if (b >= 'A' && b <= 'Z')
+			b += 'a' - 'A';
+
+		if (a != b)
+			return FALSE;
+	}
+
+	return TRUE;
+}
+
+static PR_STRING _app_utf8_to_string (
+	_In_ LPCSTR string
+)
+{
+	PR_STRING out_string;
+	LPWSTR buffer;
+	int length;
+
+	if (!string || !*string)
+		return NULL;
+
+	length = MultiByteToWideChar (CP_UTF8, 0, string, -1, NULL, 0);
+
+	if (length <= 0)
+		return NULL;
+
+	buffer = _r_mem_allocate ((ULONG_PTR)length * sizeof (WCHAR));
+
+	if (!buffer)
+		return NULL;
+
+	if (!MultiByteToWideChar (CP_UTF8, 0, string, -1, buffer, length))
+	{
+		_r_mem_free (buffer);
+
+		return NULL;
+	}
+
+	out_string = _r_obj_createstring (buffer);
+
+	_r_mem_free (buffer);
+
+	return out_string;
+}
+
+static BOOLEAN _app_is_github_release_url (
+	_In_ PR_STRING url
+)
+{
+	if (!url || !url->buffer)
+		return FALSE;
+
+	return StrStrIW (url->buffer, L"api.github.com") != NULL && StrStrIW (url->buffer, L"/releases/latest") != NULL;
+}
+
+static BOOLEAN _app_is_github_asset_match (
+	_In_ LPCSTR name,
+	_In_ PBROWSER_INFORMATION pbi
+)
+{
+	BOOLEAN is_brave_type;
+	BOOLEAN is_origin_type;
+
+	if (!name || !*name)
+		return FALSE;
+
+	if (!_app_str_endsswith_i (name, ".zip") && !_app_str_endsswith_i (name, ".7z"))
+		return FALSE;
+
+	if (_app_str_contains_i (name, "symbols") ||
+		_app_str_contains_i (name, ".sha256") ||
+		_app_str_contains_i (name, ".asc") ||
+		_app_str_contains_i (name, ".pdb") ||
+		_app_str_contains_i (name, "dsym") ||
+		_app_str_contains_i (name, "debug"))
+	{
+		return FALSE;
+	}
+
+	if (_app_str_contains_i (name, "linux") ||
+		_app_str_contains_i (name, "darwin") ||
+		_app_str_contains_i (name, "macos") ||
+		_app_str_contains_i (name, "osx") ||
+		_app_str_contains_i (name, "android") ||
+		_app_str_contains_i (name, "ios"))
+	{
+		return FALSE;
+	}
+
+	if (!_app_str_contains_i (name, "win") && !_app_str_contains_i (name, "windows"))
+		return FALSE;
+
+	is_brave_type = pbi->browser_type && StrStrIW (pbi->browser_type->buffer, L"brave") != NULL;
+	is_origin_type = pbi->browser_type && StrStrIW (pbi->browser_type->buffer, L"origin") != NULL;
+
+	if (is_brave_type && !_app_str_contains_i (name, "brave"))
+		return FALSE;
+
+	if (is_origin_type)
+	{
+		if (!_app_str_contains_i (name, "origin"))
+			return FALSE;
+	}
+	else if (_app_str_contains_i (name, "origin"))
+	{
+		return FALSE;
+	}
+
+	if (pbi->architecture == 64)
+	{
+		if (_app_str_contains_i (name, "arm64") || _app_str_contains_i (name, "aarch64"))
+			return FALSE;
+
+		if (!_app_str_contains_i (name, "x64") && !_app_str_contains_i (name, "amd64") && !_app_str_contains_i (name, "x86_64"))
+			return FALSE;
+	}
+	else
+	{
+		if (_app_str_contains_i (name, "x64") ||
+			_app_str_contains_i (name, "amd64") ||
+			_app_str_contains_i (name, "x86_64") ||
+			_app_str_contains_i (name, "arm64") ||
+			_app_str_contains_i (name, "aarch64"))
+		{
+			return FALSE;
+		}
+
+		if (!_app_str_contains_i (name, "ia32") && !_app_str_contains_i (name, "x86") && !_app_str_contains_i (name, "win32"))
+			return FALSE;
+	}
+
+	return TRUE;
+}
