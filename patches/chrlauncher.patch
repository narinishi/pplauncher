+static BOOLEAN _app_parse_github_latest (
+	_In_ PR_STRING response,
+	_Inout_ PBROWSER_INFORMATION pbi,
+	_Out_ PBOOLEAN is_error_ptr
+)
+{
+	BOOLEAN is_found = FALSE;
+	cJSON *asset;
+	cJSON *assets;
+	cJSON *root;
+	cJSON *tag;
+	LPCSTR download_url = NULL;
+	LPCSTR version;
+	LPSTR utf8_body;
+	int utf8_length;
+
+	*is_error_ptr = FALSE;
+
+	if (!response || !response->buffer || !response->length)
+	{
+		*is_error_ptr = TRUE;
+
+		return FALSE;
+	}
+
+	utf8_length = WideCharToMultiByte (CP_UTF8, 0, response->buffer, (int)(response->length / sizeof (WCHAR)), NULL, 0, NULL, NULL);
+
+	if (utf8_length <= 0)
+	{
+		*is_error_ptr = TRUE;
+
+		return FALSE;
+	}
+
+	utf8_body = _r_mem_allocate ((ULONG_PTR)utf8_length + 1);
+
+	if (!utf8_body)
+	{
+		*is_error_ptr = TRUE;
+
+		return FALSE;
+	}
+
+	WideCharToMultiByte (CP_UTF8, 0, response->buffer, (int)(response->length / sizeof (WCHAR)), utf8_body, utf8_length, NULL, NULL);
+	utf8_body[utf8_length] = ANSI_NULL;
+
+	root = cJSON_Parse (utf8_body);
+
+	_r_mem_free (utf8_body);
+
+	if (!root)
+	{
+		*is_error_ptr = TRUE;
+
+		return FALSE;
+	}
+
+	tag = cJSON_GetObjectItemCaseSensitive (root, "tag_name");
+	assets = cJSON_GetObjectItemCaseSensitive (root, "assets");
+
+	if (!cJSON_IsString (tag) || !tag->valuestring || !cJSON_IsArray (assets))
+	{
+		cJSON_Delete (root);
+
+		*is_error_ptr = TRUE;
+
+		return FALSE;
+	}
+
+	cJSON_ArrayForEach (asset, assets)
+	{
+		cJSON *name = cJSON_GetObjectItemCaseSensitive (asset, "name");
+		cJSON *url = cJSON_GetObjectItemCaseSensitive (asset, "browser_download_url");
+
+		if (!cJSON_IsString (name) || !cJSON_IsString (url))
+			continue;
+
+		if (!_app_is_github_asset_match (name->valuestring, pbi))
+			continue;
+
+		download_url = url->valuestring;
+		is_found = TRUE;
+
+		break;
+	}
+
+	version = tag->valuestring;
+
+	if (*version == 'v' || *version == 'V')
+		version++;
+
+	if (is_found && *version)
+	{
+		_r_obj_movereference ((PVOID_PTR)&pbi->download_url, _app_utf8_to_string (download_url));
+		_r_obj_movereference ((PVOID_PTR)&pbi->new_version, _app_utf8_to_string (version));
+	}
+
+	cJSON_Delete (root);
+
+	if (!is_found || _r_obj_isstringempty (pbi->download_url) || _r_obj_isstringempty (pbi->new_version))
+	{
+		SAFE_DELETE_REFERENCE (pbi->download_url);
+		SAFE_DELETE_REFERENCE (pbi->new_version);
+
+		*is_error_ptr = TRUE;
+
+		return FALSE;
+	}
+
+	return TRUE;
+}
