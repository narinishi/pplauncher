+PR_STRING _r_app_getwndowtitle ()
+{
+	static R_INITONCE init_once = PR_INITONCE_INIT;
+	static PR_STRING cached_title = NULL;
+
+	if (_r_initonce_begin (&init_once))
+	{
+		PR_STRING string;
+		BOOLEAN is_scramble;
+		ULONG_PTR length;
+
+		cached_title = _r_format_string (
+			L"%s %s %s",
+			_r_app_getname (),
+			_r_app_getversion (),
+			_r_app_getversiontype ()
+		);
+
+		string = _r_config_getstring_ex (L"IsScrambleTitle", L"false", NULL);
+
+		if (string)
+		{
+			is_scramble = _r_str_toboolean (&string->sr);
+
+			_r_obj_dereference (string);
+
+			if (is_scramble)
+			{
+				length = cached_title->length / sizeof (WCHAR);
+
+				string = _r_obj_createstring_ex (NULL, cached_title->length);
+
+				if (string)
+				{
+					_r_str_generaterandom (string->buffer, length + 1, TRUE);
+
+					_r_obj_dereference (cached_title);
+
+					cached_title = string;
+				}
+			}
+		}
+
+		_r_initonce_end (&init_once);
+	}
+
+	return cached_title;
+}
