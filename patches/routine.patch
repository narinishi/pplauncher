+}
+
+LRESULT CALLBACK _r_theme_hotkey_subclass (
+	_In_ HWND hwnd,
+	_In_ UINT msg,
+	_In_ WPARAM wparam,
+	_In_ LPARAM lparam
+)
+{
+	PR_THEME_CONTEXT context;
+	WNDPROC wnd_proc;
+
+	context = _r_wnd_getcontext (hwnd, 666);
+
+	if (!context)
+		return DefWindowProcW (hwnd, msg, wparam, lparam);
+
+	wnd_proc = context->wnd_proc;
+
+	switch (msg)
+	{
+		case WM_NCDESTROY:
+		{
+			_r_theme_cleanup (hwnd, context);
+			break;
+		}
+
+		case WM_THEMECHANGED:
+		case WM_DPICHANGED:
+		{
+			InvalidateRect (hwnd, NULL, FALSE);
+			break;
+		}
+
+		case WM_ERASEBKGND:
+		{
+			HDC hdc = (HDC)wparam;
+			RECT rect;
+
+			if (GetClientRect (hwnd, &rect))
+				_r_dc_fillrect (hdc, &rect, _r_theme_isenabled () ? WND_BACKGROUND_CLR : GetSysColor (COLOR_WINDOW));
+
+			return TRUE;
+		}
+
+		case WM_NCPAINT:
+		{
+			HDC hdc = GetWindowDC (hwnd);
+
+			if (hdc)
+			{
+				RECT rect;
+
+				if (GetClientRect (hwnd, &rect))
+				{
+					COLORREF clr_prev = SetDCBrushColor (hdc, 0x404040);
+
+					FrameRect (hdc, &rect, GetStockObject (DC_BRUSH));
+
+					if (clr_prev != CLR_INVALID)
+						SetDCBrushColor (hdc, clr_prev);
+				}
+
+				ReleaseDC (hwnd, hdc);
+			}
+
+			return 0;
+		}
+
+		case WM_PRINTCLIENT:
+		{
+			HDC hdc = (HDC)wparam;
+			RECT rect;
+			WCHAR key_name[128];
+			WCHAR hotkey_text[256] = {0};
+			BYTE vks[4];
+			WORD hotkey;
+			BYTE vk;
+			BYTE mods;
+			ULONG count;
+			ULONG_PTR length;
+			PR_STRING string;
+
+			if (!hdc || !GetClientRect (hwnd, &rect))
+				break;
+
+			hotkey = (WORD)_r_wnd_sendmessage (hwnd, 0, HKM_GETHOTKEY, 0, 0);
+			vk = LOBYTE (hotkey);
+			mods = HIBYTE (hotkey);
+			count = 0;
+
+			if (vk)
+			{
+				if (mods & HOTKEYF_CONTROL)
+					vks[count++] = VK_CONTROL;
+
+				if (mods & HOTKEYF_ALT)
+					vks[count++] = VK_MENU;
+
+				if (mods & HOTKEYF_SHIFT)
+					vks[count++] = VK_SHIFT;
+
+				vks[count++] = vk;
+
+				for (ULONG i = 0; i < count; i++)
+				{
+					if (!GetKeyNameTextW (((MapVirtualKeyW (vks[i], MAPVK_VK_TO_VSC) & 0xffff) << 16), key_name, RTL_NUMBER_OF (key_name)))
+						continue;
+
+					if (hotkey_text[0])
+						_r_str_appendformat (hotkey_text, RTL_NUMBER_OF (hotkey_text), L"+%s", key_name);
+					else
+						_r_str_printf (hotkey_text, RTL_NUMBER_OF (hotkey_text), L"%s", key_name);
+				}
+			}
+			else
+			{
+				_r_str_printf (hotkey_text, RTL_NUMBER_OF (hotkey_text), L"<none>");
+			}
+
+			length = _r_str_getlength (hotkey_text);
+
+			if (length && hotkey_text[length - 1] == L'+')
+				hotkey_text[length - 1] = UNICODE_NULL;
+
+			string = _r_obj_createstring (hotkey_text);
+
+			if (string)
+			{
+				rect.left += 2;
+
+				_r_dc_drawtext (
+					NULL,
+					hdc,
+					&string->sr,
+					&rect,
+					0,
+					0,
+					DT_LEFT | DT_VCENTER | DT_SINGLELINE,
+					_r_theme_isenabled () ? WND_TEXT_CLR : GetSysColor (COLOR_WINDOWTEXT)
+				);
+
+				_r_obj_dereference (string);
+			}
+
+			return 0;
+		}
+	}
+
 	return CallWindowProcW (wnd_proc, hwnd, msg, wparam, lparam);
 }
 
