+static WCHAR tooltip_text[1024];
+
+static LRESULT CALLBACK _rcl_tooltip_owner_proc (
+	_In_ HWND hwnd,
+	_In_ UINT msg,
+	_In_ WPARAM wparam,
+	_In_ LPARAM lparam,
+	_In_ UINT_PTR subclass_id,
+	_In_ DWORD_PTR ref_data
+)
+{
+	UNREFERENCED_PARAMETER (wparam);
+	UNREFERENCED_PARAMETER (subclass_id);
+
+	if (msg == WM_NOTIFY)
+	{
+		NMHDR* hdr = (NMHDR*)lparam;
+
+		if (hdr->code == TTN_GETDISPINFOW && hdr->hwndFrom == (HWND)ref_data)
+		{
+			NMTTDISPINFOW* disp_info = (NMTTDISPINFOW*)lparam;
+			HWND control = (HWND)disp_info->hdr.idFrom;
+
+			if (control)
+			{
+				GetWindowTextW (control, tooltip_text, RTL_NUMBER_OF (tooltip_text));
+				disp_info->lpszText = tooltip_text;
+			}
+
+			return 0;
+		}
+	}
+
+	return DefSubclassProc (hwnd, msg, wparam, lparam);
+}
+
+HWND _rcl_tooltip_create (
+	_In_ HWND hwnd
+)
+{
+	HWND htip = CreateWindowExW (
+		WS_EX_TOPMOST,
+		TOOLTIPS_CLASSW,
+		NULL,
+		WS_POPUP | TTS_ALWAYSTIP | TTS_NOPREFIX,
+		CW_USEDEFAULT,
+		CW_USEDEFAULT,
+		CW_USEDEFAULT,
+		CW_USEDEFAULT,
+		hwnd,
+		NULL,
+		NULL,
+		NULL
+	);
+
+	if (htip)
+	{
+		SetWindowPos (htip, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
+		SetWindowSubclass (hwnd, &_rcl_tooltip_owner_proc, 0x544F4F4C, (DWORD_PTR)htip);
+	}
+
+	return htip;
+}
+
+BOOLEAN _rcl_tooltip_settext (
+	_In_ HWND htip,
+	_In_ HWND hwnd,
+	_In_ INT ctrl_id,
+	_In_opt_ LPCWSTR text
+)
+{
+	TOOLINFOW tool_info = {0};
+
+	if (!htip)
+		return FALSE;
+
+	tool_info.cbSize = sizeof (tool_info);
+	tool_info.uFlags = TTF_IDISHWND | TTF_SUBCLASS;
+	tool_info.hwnd = hwnd;
+	tool_info.uId = (UINT_PTR)GetDlgItem (hwnd, ctrl_id);
+	tool_info.lpszText = (LPWSTR)text;
+
+	if (!tool_info.uId)
+		return FALSE;
+
+	return !!SendMessageW (htip, TTM_ADDTOOLW, 0, (LPARAM)&tool_info);
+}
+
+VOID _rcl_tooltip_setstyle (
+	_In_ HWND htip,
+	_In_ BOOLEAN is_enable
+)
+{
+	if (!htip)
+		return;
+
+	SendMessageW (htip, TTM_SETMAXTIPWIDTH, 0, is_enable ? 300 : -1);
+}
